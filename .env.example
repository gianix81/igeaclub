# Copia questo file in ".env" e inserisci la password.
# Il file .env NON viene versionato in git.

FTP_HOST=ftp.igeaclub.it
FTP_USER=3481244@aruba.it
FTP_PASSWORD=la-tua-password-qui

# Cartella di destinazione sul server (root del dominio su Aruba).
FTP_REMOTE_DIR=/

# Metti "true" solo se vuoi svuotare la cartella remota prima di caricare.
FTP_CLEAN=false

# Metti "true" per usare FTPS esplicito (se supportato).
FTP_SECURE=false
